# Public URL that docker clients use to reach the Nuxt auth endpoint
# Behind NPM/Traefik this should be the HTTPS URL, e.g. https://registry-ui.example.com
AUTH_PUBLIC_URL=http://localhost:3080

# Registry token auth (must match auth.token.service / issuer in registry config)
REGISTRY_AUTH_SERVICE=registry
REGISTRY_AUTH_ISSUER=registry-aio

# Bootstrap admin (seeded once on first start)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Session secret for admin UI cookies (change in production)
SESSION_SECRET=change-me-to-a-long-random-string

# Host ports (macOS often occupies 5000 via AirPlay Receiver)
REGISTRY_PORT=5050
APP_PORT=3080

# Internal registry URL used by the Nuxt app (compose service name)
REGISTRY_INTERNAL_URL=http://registry:5000
